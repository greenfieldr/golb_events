<?xml version="1.0"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_tab.settings</sheetTitle>
                <type>array</type>
                <el>
                    <settings.exclude>
                        <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.exclude</label>
                        <config>
                            <type>select</type>
                            <renderType>selectMultipleSideBySide</renderType>
                            <foreign_table>pages</foreign_table>
                            <foreign_table_where>AND {#pages}.{#doktype} = 42 AND {#pages}.{#sys_language_uid} IN (-1,0) ORDER BY pages.title ASC</foreign_table_where>
                            <size>5</size>
                            <minitems>0</minitems>
                            <maxitems>9999</maxitems>
                        </config>
                    </settings.exclude>
                    <settings.topPosts>
                        <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.topPosts</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0" type="array">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.topPosts.all</label>
                                    <value/>
                                </numIndex>
                                <numIndex index="1">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.topPosts.topPostsOnly</label>
                                    <value>topPosts</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.topPosts.nonTopPostsOnly</label>
                                    <value>nonTopPosts</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.topPosts>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
