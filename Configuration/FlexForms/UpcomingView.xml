<?xml version="1.0"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_tab.settings</sheetTitle>
                <type>array</type>
                <el>
                    <settings.mode>
                        <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.mode</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.mode.upcoming</label>
                                    <value>upcoming</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.mode.past</label>
                                    <value>past</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.mode.all</label>
                                    <value>all</value>
                                </numIndex>
                                <numIndex index="3">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.mode.range</label>
                                    <value>range</value>
                                </numIndex>
                            </items>
                            <default>upcoming</default>
                        </config>
                    </settings.mode>
                    <settings.from>
                        <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.from</label>
                        <displayCond>FIELD:settings.mode:=:range</displayCond>
                        <config>
                            <type>datetime</type>
                            <format>date</format>
                            <default>0</default>
                        </config>
                    </settings.from>
                    <settings.to>
                        <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.to</label>
                        <displayCond>FIELD:settings.mode:=:range</displayCond>
                        <config>
                            <type>datetime</type>
                            <format>date</format>
                            <default>0</default>
                        </config>
                    </settings.to>
                    <settings.sorting>
                        <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.sorting</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.sorting.start</label>
                                    <value>start</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.sorting.title</label>
                                    <value>title</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.sorting.date</label>
                                    <value>date</value>
                                </numIndex>
                                <numIndex index="3">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.sorting.crdate</label>
                                    <value>crdate</value>
                                </numIndex>
                                <numIndex index="4">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.sorting.tstamp</label>
                                    <value>tstamp</value>
                                </numIndex>
                                <numIndex index="5">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.sorting.author</label>
                                    <value>author</value>
                                </numIndex>
                            </items>
                            <default>start</default>
                        </config>
                    </settings.sorting>
                    <settings.sortingDirection>
                        <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.sortingDirection</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0" type="array">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.sortingDirection.auto</label>
                                    <value/>
                                </numIndex>
                                <numIndex index="1">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.sortingDirection.ascending</label>
                                    <value>ASC</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.sortingDirection.descending</label>
                                    <value>DESC</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.sortingDirection>
                    <settings.limit>
                        <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.limit</label>
                        <config>
                            <type>number</type>
                            <size>10</size>
                            <default>5</default>
                        </config>
                    </settings.limit>
                    <settings.offset>
                        <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.offset</label>
                        <config>
                            <type>number</type>
                            <size>10</size>
                            <default>0</default>
                        </config>
                    </settings.offset>
                    <settings.exclude>
                        <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.exclude</label>
                        <config>
                            <type>select</type>
                            <renderType>selectMultipleSideBySide</renderType>
                            <foreign_table>pages</foreign_table>
                            <foreign_table_where>AND {#pages}.{#doktype} = 42 AND {#pages}.{#sys_language_uid} IN (-1,0) ORDER BY pages.title ASC</foreign_table_where>
                            <size>5</size>
                            <minitems>0</minitems>
                            <maxitems>9999</maxitems>
                        </config>
                    </settings.exclude>
                    <settings.topPosts>
                        <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.topPosts</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0" type="array">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.topPosts.all</label>
                                    <value/>
                                </numIndex>
                                <numIndex index="1">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.topPosts.topPostsOnly</label>
                                    <value>topPosts</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.topPosts.nonTopPostsOnly</label>
                                    <value>nonTopPosts</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.topPosts>
                    <settings.allowDemandOverwrite>
                        <label>LLL:EXT:golb_events/Resources/Private/Language/locallang_be.xlf:flexforms_general.allowDemandOverwrite</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.allowDemandOverwrite>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
